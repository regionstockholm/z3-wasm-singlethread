# Single source of truth for what gets built. Changing any line is a reviewed PR.
# Z3: upstream release tag and the commit it must resolve to (checked against the remote tag).
Z3_TAG=z3-5.3.2
Z3_COMMIT=b411c90217766c924e6ea3d0b51f452a89fd8fc2
Z3_REPO=https://github.com/Z3Prover/z3.git
# Emscripten: same version upstream Z3 uses for its own wasm build (.github/workflows/wasm.yml at Z3_TAG).
EMSDK_VERSION=3.1.73
EMSDK_COMMIT=6abe5123c34a7751a2d5b679e856b2591ba04145
EMSDK_REPO=https://github.com/emscripten-core/emsdk.git
# The upstream build recipe this build mirrors (src/api/js/scripts/build-wasm.ts at Z3_TAG).
# If upstream changes it, the build stops until BUILD-DIFF.md is re-checked and this hash updated.
Z3_BUILD_WASM_TS_SHA256=46c0686415ebd18b58d05ea09797e815d2f823a28aaf1ab896b4db63b01c669f
# Exception model: "js" = same as upstream (-s DISABLE_EXCEPTION_CATCHING=0), "wasm" = -fwasm-exceptions.
Z3W_EXCEPTIONS=js
